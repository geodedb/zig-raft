            .hash = "wal-0.1.1-EqPqpo1ABABwgaA4SY5tbkJGzavZyJApuHCuHaiDWU92",
        },
        // Gated otel dependency — only fetched when `-Dwith_otel=true`
        // because `b.lazyDependency("otel", ...)` is called only inside
        // the `if (with_otel)` block in build.zig. When the flag is off,
        // the package manager never resolves this entry.
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git#v0.1.3",
            .hash = "otel-0.1.3-B0v3lrgLNAAV-o70i1bvVUuOsugHWnPtUB8SbLoGaBQ-",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
